import pandas as pd
import numpy as np
from scipy.stats import binom

# Настройка отображения данных
pd.set_option('display.max_columns', None)

# Загрузка данных
file_path = r'C:\Users\TOP\Downloads\Data_8_1.xlsx'
try:
    data = pd.read_excel(file_path, engine='openpyxl')
except FileNotFoundError:
    raise SystemExit("Ошибка: Файл не найден. Проверьте путь и название файла.")

# Просмотр структуры данных
print("Первые 5 строк данных:")
print(data.head())
print("\nСтолбцы в данных:", data.columns.tolist())

# Обработка данных
## Замена дефисов и некорректных значений на NaN
data = data.replace('-', np.nan)
data = data.replace('', np.nan)

## Преобразование в числовой формат
for column in data.columns:
    data[column] = pd.to_numeric(data[column], errors='coerce')

# Проверка наличия нужных столбцов (возможны постфиксы в реальных данных)
oma_column = next((col for col in data.columns if 'ОМА' in col), None)
ma_column = next((col for col in data.columns if 'МА' in col), None)

if not oma_column or not ma_column:
    raise KeyError(f"Не найдены столбцы ОМА и/или МА. Доступные столбцы: {data.columns.tolist()}")

# Удаление строк с пропусками в анализируемых столбцах
clean_data = data[[oma_column, ma_column]].dropna()

# Извлечение данных
oma = clean_data[oma_column].values
ma = clean_data[ma_column].values

# Диапазон M от 0 до 1 с шагом 0.01
m_values = np.arange(0, 1.01, 0.01)
results = []

# Функция для вычисления p-value без использования теста Мак-Немара
def calculate_p_value(table):
    try:
        b = table[0][1]
        c = table[1][0]
        n = b + c
        if n == 0:
            return np.nan
        # Точный тест Мак-Немара через биномиальное распределение
        p = 2 * binom.cdf(min(b, c), n, 0.5)
        return min(p, 1.0)
    except:
        return np.nan

# Основной цикл анализа
for M in m_values:
    # Создание бинарных векторов
    oma_success = oma >= M
    ma_success = ma >= M

    # Построение таблицы сопряженности
    contingency_table = np.array([
        [np.sum(oma_success & ma_success), np.sum(oma_success & ~ma_success)],
        [np.sum(~oma_success & ma_success), np.sum(~oma_success & ~ma_success)]
    ])

    # Вычисление p-value
    p_value = calculate_p_value(contingency_table)

    results.append({'M': M, 'p_value': p_value})

# Формирование DataFrame с результатами
results_df = pd.DataFrame(results)

# Функция для определения диапазонов
def find_significance_ranges(p_values, m_values, alpha=0.05):
    ranges = []
    current_start = None

    for i in range(len(p_values)):
        significant = not np.isnan(p_values[i]) and p_values[i] < alpha

        if significant:
            if current_start is None:
                current_start = m_values[i]
            current_end = m_values[i]
        else:
            if current_start is not None:
                ranges.append((round(current_start, 2), round(current_end, 2)))
                current_start = None

    # Добавление последнего диапазона
    if current_start is not None:
        ranges.append((round(current_start, 2), round(current_end, 2)))

    return ranges

# Определение диапазонов значимости
petr_ranges = find_significance_ranges(results_df['p_value'].values, results_df['M'].values)
ivan_mask = results_df['p_value'] >= 0.05
ivan_ranges = find_significance_ranges(ivan_mask.astype(float).values, results_df['M'].values, alpha=1)

# Вывод результатов
print("\nРезультаты анализа:")
print(f"Диапазоны M, подтверждающие Ивана (p ≥ 0.05):")
for r in ivan_ranges:
    print(f"{r[0]:.2f} - {r[1]:.2f}")

print("\nДиапазоны M, подтверждающие Петра (p < 0.05):")
for r in petr_ranges:
    print(f"{r[0]:.2f} - {r[1]:.2f}")