import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
from scipy.stats import boxcox as sts_boxcox, shapiro as sts_shapiro, probplot
import seaborn as sns

# --- 1. Загрузка данных (пример) ---
data = pd.DataFrame({
    'A': np.random.exponential(scale=2, size=100),
    'B': np.random.lognormal(mean=1, sigma=0.5, size=100)
})

# --- 2. Преобразование Бокса-Кокса с использованием sts.boxcox ---
def apply_boxcox(series):
    # Корректировка неположительных значений
    if (series <= 0).any():
        series = series + 1e-6
    transformed, lambda_opt = sts_boxcox(series, lmbda=None, alpha=None)
    return transformed, lambda_opt

# Применяем преобразование
data['AA'], lambda_A = apply_boxcox(data['A'].copy())
data['BB'], lambda_B = apply_boxcox(data['B'].copy())

# --- 3. Построение гистограмм ---
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

# Исходные данные
sns.histplot(data['A'], kde=True, ax=axes[0, 0], color='blue')
axes[0, 0].set_title(f'A (λ={lambda_A:.2f})')
sns.histplot(data['B'], kde=True, ax=axes[0, 1], color='green')
axes[0, 1].set_title(f'B (λ={lambda_B:.2f})')

# Преобразованные данные
sns.histplot(data['AA'], kde=True, ax=axes[1, 0], color='red')
axes[1, 0].set_title('AA (Box-Cox)')
sns.histplot(data['BB'], kde=True, ax=axes[1, 1], color='orange')
axes[1, 1].set_title('BB (Box-Cox)')

plt.tight_layout()
plt.show()

# --- 4. Проверка нормальности с использованием sts.shapiro ---
def check_normality(data, name):
    stat, p = sts_shapiro(data)
    print(f"{name}: p-value = {p:.4f}")
    print("▶ Нормальность не отвергается" if p > 0.05 else "▶ Нормальность отвергается")

print("\n--- Результаты критерия Шапиро-Уилка ---")
check_normality(data['A'], 'A')
check_normality(data['AA'], 'AA')
check_normality(data['B'], 'B')
check_normality(data['BB'], 'BB')

# --- 5. Построение Q-Q графиков ---
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

# Исходные данные
probplot(data['A'], plot=axes[0, 0])
axes[0, 0].set_title('Q-Q для A')
probplot(data['B'], plot=axes[0, 1])
axes[0, 1].set_title('Q-Q для B')

# Преобразованные данные
probplot(data['AA'], plot=axes[1, 0])
axes[1, 0].set_title('Q-Q для AA')
probplot(data['BB'], plot=axes[1, 1])
axes[1, 1].set_title('Q-Q для BB')

plt.tight_layout()
plt.show()
#1. Гистограммы
# Исходные данные: A: Экспоненциальное распределение → асимметрия вправо; B: Логнормальное распределение и длинны правый хвост
# Преобразованные данные: AA: Распределение ближе к нормальному, симметрия улучшена; BB: Хвосты сокращены, форма приближена к нормальной
#2. Критерий Шапиро-Уилка
# Преобразование Бокса-Кокса сделало распределения A и B неотличимыми от нормального.
# 3. Q-Q графики
# Исходные данные: A: Точки отклоняются от прямой из чего можно предположить не нормальность, B: Сильные отклонения в хвостах
# Преобраованные данные: AA: Точки близки к прямой из чего можно предположить нормальность BB: Отклонения уменьшены.
# Преобразование Бокса-Кокса эффективно нормализовало исходные выборки. Результаты Q-Q графиков согласуются с критерием Шапиро-Уилка.